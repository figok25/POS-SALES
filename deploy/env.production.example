# CONTOH .env UNTUK SERVER PRODUKSI -- salin ke /var/www/pos-sales/.env lalu isi nilai bertanda GANTI.
#   cp deploy/env.production.example .env
#   php artisan key:generate        # mengisi APP_KEY otomatis (jangan isi manual)
# JANGAN pernah meng-commit file .env ke Git.

APP_NAME="POS Sales"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.contoh.com            # GANTI: domain kamu, wajib https
APP_TIMEZONE=Asia/Jakarta                 # jangan diubah setelah ada data produksi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database PostgreSQL di server yang sama
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pos_sales
DB_USERNAME=pos_user
DB_PASSWORD=GANTI_PASSWORD_DATABASE

# Routing TomTom -- pakai API key milik sendiri (key lama sudah bocor di Git, buat yang baru)
ROUTING_PROVIDER=tomtom
TOMTOM_API_KEY=GANTI
TOMTOM_BASE_URL=https://api.tomtom.com
TOMTOM_TIMEOUT_SECONDS=10
ROUTING_MONTHLY_HARD_BUDGET=18000
ROUTING_REROUTE_THRESHOLD_METERS=200
ROUTING_REROUTE_COOLDOWN_SECONDS=300
ROUTING_API_KEY=GANTI                       # isi sama dengan TOMTOM_API_KEY

# Peta (MapLibre + OpenFreeMap, gratis tanpa key)
MAP_ENGINE=maplibre
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_TILE_PROVIDER=openfreemap

# Sanctum / sesi (HTTPS)
SANCTUM_STATEFUL_DOMAINS=pos.contoh.com     # GANTI: domain tanpa https://
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Hapus riwayat lokasi Sales yang lebih tua dari N hari (otomatis tiap malam)
SALES_LOCATION_RETENTION_DAYS=60

# Email: masih "log" (email lupa-password tidak benar-benar terkirim).
# Ganti ke smtp bila perlu, mis. SMTP email Hostinger.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pos.contoh.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
