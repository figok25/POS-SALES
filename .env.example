APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:AzI/X4jnjZiVzYYefGWZInGlasa2BopTE/NoQOXdpso=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pos_sales
DB_USERNAME=postgres
DB_PASSWORD=

# Section 92-97: TomTom Routing
# Daftar gratis di https://developer.tomtom.com (20.000 request/bulan,
# tanpa kartu kredit), buat API Key baru, lalu isi kedua baris di bawah
# dengan API key yang SAMA (dua fitur berbeda pakai config terpisah --
# lihat config/routing.php vs config/services.php 'routing').
ROUTING_PROVIDER=tomtom
# Dipakai App\Providers\RoutingServiceProvider -> RoutingService (Rute
# Harian / Today's Route + reroute otomatis saat Sales menyimpang jalur).
TOMTOM_API_KEY=a22kbb3Pno4KY54bWTUvXiFNzWL3jAEg
# HARUS root domain saja (TomTomRoutingAdapter/Orbis v3 menyusun sendiri
# path /maps/orbis/routing/routes/calculate). JANGAN tambahkan /routing/1
# di belakangnya -- itu path API v1 lama yang sudah tidak dipakai adapter ini.
TOMTOM_BASE_URL=https://api.tomtom.com
TOMTOM_TIMEOUT_SECONDS=10
ROUTING_MONTHLY_HARD_BUDGET=18000
ROUTING_REROUTE_THRESHOLD_METERS=300
ROUTING_REROUTE_COOLDOWN_SECONDS=300
# Dipakai App\Providers\AppServiceProvider -> RoutingEngine interface
# (navigasi single tujuan, mis. Sales\RouteController@calculate). Isi
# dengan API key TomTom yang SAMA seperti TOMTOM_API_KEY di atas.
ROUTING_API_KEY=a22kbb3Pno4KY54bWTUvXiFNzWL3jAEg

# MapLibre (rendering peta) -- default OpenFreeMap ini GRATIS, TANPA API
# key/registrasi, tidak perlu diubah kecuali mau ganti provider tile lain.
MAP_ENGINE=maplibre
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_TILE_PROVIDER=openfreemap

# Sanctum (token untuk Sales APK)
SANCTUM_STATEFUL_DOMAINS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
